# ローカル開発で consumer.py を起動する際の環境変数テンプレート。
# 値を埋めて kafka2/consumer/.env として保存する (リポジトリ管理外)。
# AWS アカウント ID やバケット名はデプロイ先に合わせて差し替える。

# Structured Streaming の checkpointLocation 用 S3 バケット名 (s3a:// プレフィックス除く)。
# 命名規約: kafka-consumer-checkpoint-<アカウントID>-<env>
CHECKPOINT_BUCKET=kafka-consumer-checkpoint-<アカウントID>-dev

# 出力 parquet (sample-events-event/, sample-events-dlq/) を書き込む S3 バケット名
# (s3a:// プレフィックス除く)。
OUTPUT_BUCKET=kafka-consumer-output-<アカウントID>-dev

# PySpark 起動時の --packages / --conf。parquet 書き込みのみのため Iceberg / S3 Tables
# catalog 関連の package・conf は不要。
PYSPARK_SUBMIT_ARGS=--packages org.apache.spark:spark-protobuf_2.12:3.5.6,org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.6,org.apache.hadoop:hadoop-aws:3.4.1,software.amazon.awssdk:bundle:2.24.6 --conf spark.hadoop.fs.s3a.aws.credentials.provider=software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider pyspark-shell
